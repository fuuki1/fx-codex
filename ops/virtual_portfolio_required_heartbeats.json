    {
      "service_id": "com.fx-codex.briefing",
      "path": "logs/briefing_decisions_latest.json",
      "max_age_seconds": 900
    },
    {
      "service_id": "com.fx-codex.dukascopy-history",
      "path": "collect/log/quotes.jsonl",
      "max_age_seconds": 900
    },
    {
      "service_id": "com.fx-codex.quote-index",
      "path": "logs/quote_tape_index_status.json",
      "max_age_seconds": 180
    },
    {
      "service_id": "com.fx-codex.health",
      "path": "logs/freshness_report.json",
      "max_age_seconds": 600,
      "status_field": "overall",
      "status_value": "ok"
    }
