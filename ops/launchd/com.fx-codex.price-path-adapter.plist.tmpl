<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 収集済み Dukascopy tick を確定足へ畳み、採点用の価格経路へ供給する。

       なぜ必要か:
         採点は TP/SL 到達を価格経路の high/low で判定するが、5分スナップショット
         は形成中バー(ohlc_scope=forming_bar_snapshot)しか持たず、PIT 保護により
         high/low が棄却される。tick を畳んだ確定足だけが
         lower_timeframe_closed_bar を名乗れる。

       起動時刻:
         毎時 10/25/40/55 分。decision feedback refresh(monitor-diagnostics、
         毎時 14/29/44/59 分)の 4 分前に確定足を揃える。採点用の共有5分足は
         feedback 側で 210 分(市場オープン時間)を超えると stale と判定されるが、
         正常時でも xx:29 時点で最新足は 149 分前にあり、収集器が 1 時間分を
         取りこぼす(Dukascopy HTTP 503 など)と、毎時 1 回の実行では次の実行まで
         約 45 分 feedback が止まっていた。15 分毎なら、収集器が再取得した直後の
         実行で追いつく。
         確定判定は収集器の completed_hours に従うので、取り込み途中の時間帯は
         書かない。何度走っても tick 全体から確定足を再生成する冪等な処理で、
         既に書いた行は自然キーで重複スキップされる。

       この process は構造的に発注できない:
         読むのは収集済み JSONL だけで、ネットワークも broker 経路も持たない。 -->
  <key>Label</key>
  <string>com.fx-codex.price-path-adapter</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/.venv/bin/python</string>
    <string>__ROOT__/tools/price_path_adapter_run.py</string>
    <string>--write</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <!-- 起動時に走らせない。load 直後の実行は、収集器の取り込み途中と重なる
       可能性があり、待って次の定刻に回すほうが安全。 -->
  <key>RunAtLoad</key>
  <false/>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>10</integer></dict>
    <dict><key>Minute</key><integer>25</integer></dict>
    <dict><key>Minute</key><integer>40</integer></dict>
    <dict><key>Minute</key><integer>55</integer></dict>
  </array>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/srv/fx-codex/logs/launchd/price-path-adapter.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/srv/fx-codex/logs/launchd/price-path-adapter.err.log</string>
</dict>
</plist>
