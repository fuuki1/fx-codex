<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fx-codex.operational-read</string>
  <!-- The server itself hard-codes 127.0.0.1 and opens SQLite in immutable
       query-only mode. It cannot become a public or writer endpoint through
       launchd configuration. -->
  <key>ProgramArguments</key>
  <array>
    <string>__OPERATIONAL_PYTHON__</string>
    <string>__FX_ROOT__/tools/operational_read_api.py</string>
    <string>--db</string><string>__OPERATIONAL_DB__</string>
    <string>--port</string><string>__OPERATIONAL_READ_PORT__</string>
  </array>
  <key>WorkingDirectory</key><string>__FX_ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__FX_ROOT__/logs/launchd/operational-read.out.log</string>
  <key>StandardErrorPath</key><string>__FX_ROOT__/logs/launchd/operational-read.err.log</string>
</dict>
</plist>
