<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fx-codex.quote-index</string>
  <!-- 原本JSONLは変更せず、追記された完全行のbyte offsetだけを索引化する。 -->
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__FX_ROOT__/tools/run_exclusive.py</string>
    <string>--name</string><string>fx-quote-index</string>
    <string>--locks-dir</string><string>__FX_ROOT__/logs/locks</string>
    <string>--</string>
    <string>__PYTHON__</string>
    <string>__FX_ROOT__/tools/quote_tape_index.py</string>
    <string>--source</string><string>__FX_ROOT__/collect/log/quotes.jsonl</string>
    <string>--db</string><string>__FX_ROOT__/collect/index/quotes.sqlite3</string>
    <string>--status-output</string><string>__FX_ROOT__/logs/quote_tape_index_status.json</string>
  </array>
  <key>WorkingDirectory</key><string>__FX_ROOT__</string>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__FX_ROOT__/logs/launchd/quote-index.out.log</string>
  <key>StandardErrorPath</key><string>__FX_ROOT__/logs/launchd/quote-index.err.log</string>
</dict>
</plist>
