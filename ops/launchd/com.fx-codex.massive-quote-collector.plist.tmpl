<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Read-only Massive FX BBO collector. No credential is embedded here. -->
  <key>Label</key>
  <string>com.fx-codex.massive-quote-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__ROOT__/scripts/run_massive_quote_collector.sh</string>
    <string>--launchd</string>
    <string>--output-root</string>
    <string>__HOME__/srv/fx-codex/collect</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/srv/fx-codex/collect/logs/massive-collector.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/srv/fx-codex/collect/logs/massive-collector.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
