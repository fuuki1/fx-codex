<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>EnvironmentVariables</key><dict><key>PYTHONPATH</key><string>__FX_ROOT__</string></dict>
  <key>Label</key><string>com.fx-codex.monitor-diagnostics</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__FX_ROOT__/tools/run_exclusive.py</string>
    <string>--name</string><string>fx-monitor-diagnostics</string>
    <string>--locks-dir</string><string>__FX_ROOT__/logs/locks</string>
    <string>--</string>
    <string>/bin/zsh</string>
    <string>__FX_ROOT__/scripts/fx_monitor_diagnostics_once.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__FX_ROOT__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>7</integer></dict>
    <dict><key>Minute</key><integer>22</integer></dict>
    <dict><key>Minute</key><integer>37</integer></dict>
    <dict><key>Minute</key><integer>52</integer></dict>
  </array>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__FX_ROOT__/logs/launchd/monitor-diagnostics.out.log</string>
  <key>StandardErrorPath</key><string>__FX_ROOT__/logs/launchd/monitor-diagnostics.err.log</string>
</dict>
</plist>
