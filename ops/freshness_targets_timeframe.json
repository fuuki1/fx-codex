{
  "schema": 1,
  "comment_ja": "時間足別統合ブリーフィングの運用ゲート専用設定。価格・判断journalと、定時判断が直接読むmonitor生成学習cacheを監視する。旧fusion_journalとpromotion_stateは定期経路へ混在させない。",
  "cooldown_seconds": 21600,
  "targets": [
    {
      "name": "tf_price_snapshot",
      "path": "logs/briefing_tf_prices.jsonl",
      "kind": "jsonl",
      "expected_interval_seconds": 300,
      "warn_after_seconds": 900,
      "critical_after_seconds": 2700,
      "required_symbols": ["GBPUSD", "EURUSD", "USDJPY"],
      "required_timeframes": ["15m", "1h", "4h", "1d"],
      "manual_action_ja": "scripts/status_fx_services.sh で com.fx-codex.snapshot を確認し、TradingView取得と価格履歴の競合を調査"
    },
    {
      "name": "tf_journal",
      "path": "logs/briefing_tf_journal.jsonl",
      "kind": "jsonl",
      "expected_interval_seconds": 300,
      "warn_after_seconds": 900,
      "critical_after_seconds": 2700,
      "manual_action_ja": "logs/launchd/briefing.err.log を確認し、com.fx-codex.briefing を再起動"
    },
    {
      "name": "timeframe_learning_monitor",
      "path": "logs/timeframe_learning_monitor.json",
      "kind": "json",
      "expected_interval_seconds": 900,
      "warn_after_seconds": 1800,
      "critical_after_seconds": 2700,
      "manual_action_ja": "logs/launchd/monitors.err.log を確認し、com.fx-codex.monitors を再起動"
    },
    {
      "name": "learning_profile",
      "path": "logs/briefing_tf_learning.json",
      "kind": "json",
      "expected_interval_seconds": 900,
      "warn_after_seconds": 1800,
      "critical_after_seconds": 2700,
      "manual_action_ja": "timeframe_learning_monitor.json とcache contractを確認"
    },
    {
      "name": "tp_sl_learning_profile",
      "path": "logs/briefing_tp_sl_learning.json",
      "kind": "json",
      "expected_interval_seconds": 900,
      "warn_after_seconds": 1800,
      "critical_after_seconds": 2700,
      "manual_action_ja": "timeframe_learning_monitor.json とcache contractを確認"
    },
    {
      "name": "maximization_profile",
      "path": "logs/briefing_maximization.json",
      "kind": "json",
      "expected_interval_seconds": 900,
      "warn_after_seconds": 1800,
      "critical_after_seconds": 2700,
      "manual_action_ja": "timeframe_learning_monitor.json とcache contractを確認"
    },
    {
      "name": "decision_feedback_profile",
      "path": "logs/briefing_decision_feedback.json",
      "kind": "json",
      "expected_interval_seconds": 900,
      "warn_after_seconds": 1800,
      "critical_after_seconds": 2700,
      "manual_action_ja": "decision_expectancy_monitor.json とcache contractを確認"
    }
  ]
}
